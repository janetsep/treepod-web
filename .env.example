# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# URL Base (Importante para retornos de Webpay)
# EN PRODUCCIÓN: debe ser EXACTAMENTE el dominio que sirve el sitio (con o sin www,
# el mismo que use el hosting) o el retorno de Transbank puede romperse por un redirect.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta (Facebook) — Pixel del cliente + token de Conversions API (SOLO servidor)
# OJO: el token de CAPI ya NO usa prefijo NEXT_PUBLIC_ (no debe llegar al cliente).
NEXT_PUBLIC_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=

# Transbank Webpay
# 'INTEGRATION' para pruebas, 'PRODUCTION' para real
TRANSBANK_ENVIRONMENT=INTEGRATION
# Código de comercio (597055555532 es el de integración)
TRANSBANK_COMMERCE_CODE=597055555532
# API Key (Esta es la pública de integración)
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C

# Alerta de WhatsApp a la administración (capacidad de aseo: reservas web en días con 2+ salidas)
# Gratis vía CallMeBot: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 1) Agrega el número de CallMeBot a tus contactos y envíale "I allow callmebot to send me messages"
# 2) Te responden con tu API key
# WHATSAPP_ALERT_PHONE: tu número con código país, SIN "+" (ej: 56984643307)
WHATSAPP_ALERT_PHONE=
WHATSAPP_ALERT_APIKEY=
